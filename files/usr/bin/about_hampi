#!/usr/bin/bash
#
# "About HamPi64" dialog.
# HamPi64 is the 64-bit edition of HamPi, originally created by Dave Slotter (W3DJS).
# This fork (github.com/DaiTengu/HamPi64) updates HamPi for 64-bit
# Raspberry Pi OS Trixie on the Raspberry Pi 5.
#
VER=$(grep -o '".*"' /etc/hampi-release | sed 's/"//g' | head -n 1)
SUPPORT_URL=$(grep -o 'SUPPORT_URL.*' /etc/hampi-release | sed -e 's/SUPPORT_URL=//g' -e 's/"//g' | head -n 1)
BUG_REPORT_URL=$(grep -o 'BUG_REPORT_URL.*' /etc/hampi-release | sed -e 's/BUG_REPORT_URL=//g' -e 's/"//g' | head -n 1)

TEXT="${VER}

HamPi64 is the 64-bit edition of <b>HamPi</b>, originally created by <b>Dave Slotter, W3DJS</b> (<a href=\"https://qrz.com/db/W3DJS\">qrz.com/db/W3DJS</a>).

A 64-bit port for Raspberry Pi OS (Trixie) on the Raspberry Pi 5, by <b>Mike Miller (KD9QHQ)</b>.

Project: <a href=\"${SUPPORT_URL}\">${SUPPORT_URL}</a>
Bug reports: <a href=\"${BUG_REPORT_URL}\">${BUG_REPORT_URL}</a>

HamPi is free software, licensed under the GNU GPL v3."

zenity --info --width=500 --title "About HamPi64" --text "$TEXT"
